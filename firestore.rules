rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile, conversation history, and personal memory
    // Authenticated users can read and write only their own records and subcollections
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allChildren=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Multi-User Gmail Connections (Encrypted credentials)
    // CRITICAL: Block all direct client-side reads and writes!
    // Only backend serverless functions with Firebase Admin SDK can access this collection.
    match /gmailConnections/{userId} {
      allow read, write: if false;
    }
  }
}
