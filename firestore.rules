rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and conversation history
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Thread subcollections
      match /threads/{threadId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Multi-User Gmail Connections (Encrypted credentials)
    // CRITICAL: Block all direct client-side reads and writes!
    // Only backend serverless functions with Firebase Admin SDK can access this collection.
    match /gmailConnections/{userId} {
      allow read, write: if false;
    }
  }
}
