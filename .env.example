# Groq API Keys (server-side only — used by /api serverless functions)
# Automatic failover: Key 1 will fail over to Key 2 upon rate limit (429) or key exhaustion
GROQ_API_KEY_1=your_primary_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here # Legacy fallback if GROQ_API_KEY_1 is not provided

# Firebase Configuration (client-side — VITE_ prefix exposes to browser)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Google OAuth 2.0 & Gmail Integration (server-side only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_REFRESH_TOKEN=
