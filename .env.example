# Groq API Keys (server-side only — used by /api serverless functions)
# Automatic failover: Key 1 will fail over to Key 2 upon rate limit (429) or key exhaustion
GROQ_API_KEY_1=your_primary_groq_api_key_here
GROQ_API_KEY_2=your_secondary_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here # Legacy fallback if GROQ_API_KEY_1 is not provided

# Firebase Configuration (client-side — VITE_ prefix exposes to browser)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Google OAuth 2.0 Application Credentials (server-side only — shared across all users)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://aira-ai-taupe.vercel.app/api/gmail/callback

# Multi-User Gmail Token Encryption Key (server-side only — single AIRA AES-256 key)
GMAIL_TOKEN_ENCRYPTION_KEY=your_secure_random_encryption_key_here

# Firebase Admin Service Account (server-side only — JSON string from Firebase Console)
# Required in production on Vercel for server-side Firestore access
FIREBASE_SERVICE_ACCOUNT_KEY=

# Server-Side Web Search API Key (optional — falls back to zero-key search if omitted)
TAVILY_API_KEY=your_tavily_api_key_here

